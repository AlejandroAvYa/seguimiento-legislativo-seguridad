,"no":3,"abstencion":0,"otros":0},{"partido":"Frente Amplio","si":2,"no":0,"abstencion":0,"otros":0},{"partido":"P.C","si":2,"no":0,"abstencion":0,"otros":0},{"partido":"P.D.C.","si":1,"no":1,"abstencion":0,"otros":0},{"partido":"P.P.D.","si":0,"no":2,"abstencion":0,"otros":0},{"partido":"Demócratas","si":1,"no":0,"abstencion":0,"otros":0},{"partido":"Evópoli","si":0,"no":1,"abstencion":0,"otros":0},{"partido":"F.R.E.V.S.","si":1,"no":0,"abstencion":0,"otros":0}]}],"indicaciones_por_autor":[],"indicaciones_por_articulo":[],"votaciones_camara":[],"etapa_codigo":"2C","etapa_texto":"Segundo trámite · Comisión (Cámara de Diputados)","avance_estados":{"1C":"hecha","1S":"hecha","2C":"actual","2S":"pendiente","3T":"pendiente","CM":"pendiente","TC":"pendiente","LEY":"pendiente"},"avance_camaras":{"1C":"Senado","1S":"Senado","2C":"Cámara de Diputados","2S":"Cámara de Diputados","3T":"Senado","CM":"Ambas cámaras","TC":"","LEY":""},"avance_inicio":{"1":"2026-04-20","2":"2026-09-30"},"n_urgencias_en_etapa":3,"alertas":[],"n_alertas":0,"prioridad_indice":61,"prioridad_nivel":"Alta","accion_sugerida":"Seguimiento semanal de la comisión","prioridad_motivos":["Urgencia suma (+25)","En segundo trámite (+6)","Proyecto núcleo de seguridad (+15)","Mensaje del actual Gobierno (+10)","Movimiento en los últimos 14 días (+5)"],"ritmo":{"tramite":"Segundo trámite","dias":40,"mediana":221,"n_base":18,"lectura":"más rápido que lo habitual"},"comision_actual":{},"resumen":{"estado":["Está en segundo trámite en la Cámara de Diputados, en la comisión de Seguridad Ciudadana, desde el 30 de septiembre (40 días).","El Senado lo aprobó en general y en particular el 29 de septiembre.","Tiene urgencia suma; el plazo estimado vence el 17 de noviembre.","Último trámite, sin contar urgencias: Cuenta de proyecto. Pasa a Comisión de Seguridad Ciudadana (30 de septiembre).","Desde su último avance se han presentado o renovado 3 urgencias."],"indicado":["Última votación en la Sala del Senado (29 de septiembre): 10 a favor, 24 en contra y 1 abstenciones ().","Último informe: Primer informe de comisión de Seguridad Pública (28 de agosto)."],"falta":["Falta que la comisión despache su informe y que la Sala de la Cámara lo vote.","Si la Cámara de Diputados lo aprueba sin cambios, queda despachado al Ejecutivo; si introduce modificaciones, vuelve al Senado en tercer trámite (y a Comisión Mixta si hay discrepancias)."],"redactado":{"fecha":"2026-11-04","autor":"Redacción automática","estado":"por revisar","secciones":[{"titulo":"Principales contenidos","items":["**Juicio oral en ausencia:** si el acusado no comparece sin justificación, el tribunal puede ordenar que el juicio se haga sin él. Se exige que haya sido notificado con los apercibimientos o declarado rebelde, que la pena pedida no supere veinte años y que cuente con defensa.","**Advertencia previa:** al citar a juicio oral se debe advertir al acusado que su inasistencia injustificada permite hacer el juicio en su ausencia.","**Condena y captura:** dictada una sentencia condenatoria en ausencia, la orden de detención se transforma en orden de aprehensión para cumplir la condena, con carácter preferente.","**Llegada tardía:** si el acusado llega una vez iniciado el juicio, se le informa lo ocurrido. La prueba ya rendida no se repite, salvo que el tribunal lo ordene por resolución fundada.","**Procedimiento simplificado:** el juicio simplificado también puede hacerse en ausencia si el requerido fue notificado, advertido de esa posibilidad y tiene defensor.","**Continuidad de la defensa:** si el defensor renuncia, abandona o no asiste sin justificación, el tribunal debe adoptar de inmediato medidas para asegurar la defensa.","**Nulidad:** agrega como motivo de nulidad haber hecho el juicio en ausencia sin cumplir los requisitos legales.","**Búsqueda del condenado rebelde:** el Ministerio Público puede pedir medidas investigativas, incluida la obtención de datos de tráfico, georreferenciación y metadatos como direcciones IP, IMEI o IMSI, para localizar y capturar al condenado."],"parrafos":[]}]}}}
